# --- OS ---
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/

# --- Env files (never commit real secrets) ---
.env
.env.*
!.env.example
!.env.*.example

# --- Node / frontend (create-next-app also ships frontend/.gitignore) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# --- Python / backend ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- Supabase ---
# Chiave di firma JWT locale (docs/adr/0012): contiene la componente
# privata, va generata con `supabase gen signing-key`, mai committata.
supabase/signing_keys.json

# --- Docker ---
*.pid

# --- Logs ---
*.log
