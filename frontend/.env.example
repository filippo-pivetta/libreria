# URL pubblico del progetto Supabase.
# In locale corrisponde all'API URL stampato da `supabase start` (di norma http://localhost:54321).
NEXT_PUBLIC_SUPABASE_URL=

# Chiave anon pubblica del progetto Supabase.
# Sicura da esporre nel browser solo perché le regole di riga (RLS) sono sempre attive (docs/adr/0001).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL del backend FastAPI, senza slash finale.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
