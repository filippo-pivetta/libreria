# --- Supabase / database ---

# URL del progetto Supabase (locale: quello stampato da `supabase start`,
# di norma http://localhost:54321).
SUPABASE_URL=

# Chiave anon: usata per i client che operano con l'identità dell'utente,
# cosi che le regole di riga restino sempre valutate (docs/adr/0001).
SUPABASE_ANON_KEY=

# Chiave di servizio: riservata ai lavori in background, mai a richieste
# di utenti (docs/adr/0001).
SUPABASE_SERVICE_ROLE_KEY=

# Stringa di connessione diretta a Postgres (locale: quella stampata da
# `supabase start`).
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- App ---

ENVIRONMENT=development

# Origini ammesse per il CORS, separate da virgola.
CORS_ORIGINS=http://localhost:3000

# --- Funzioni assistite (non ancora implementate, vedi docs/prd.md) ---

GOOGLE_BOOKS_API_KEY=
OPENAI_API_KEY=
