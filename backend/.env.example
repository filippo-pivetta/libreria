# --- Supabase / database ---

# URL del progetto Supabase (locale: quello stampato da `supabase start`,
# di norma http://localhost:54321).
SUPABASE_URL=

# Chiave anon: usata per i client che operano con l'identità dell'utente,
# cosi che le regole di riga restino sempre valutate (docs/adr/0001).
SUPABASE_ANON_KEY=

# Chiave di servizio: riservata ai lavori in background, mai a richieste
# di utenti (docs/adr/0001).
SUPABASE_SERVICE_ROLE_KEY=

# Stringa di connessione diretta a Postgres (locale: quella stampata da
# `supabase start`).
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Autenticazione ---

# Issuer atteso nei JWT di sessione, verificato dalla dipendenza di
# autenticazione (docs/adr/0012). Lasciata vuota nella quasi totalità dei
# casi: si deriva da SUPABASE_URL (`${SUPABASE_URL}/auth/v1`), che è il
# default sia in locale sia sul progetto hosted. Da impostare solo se il
# progetto usa un dominio personalizzato che non coincide con SUPABASE_URL.
SUPABASE_JWT_ISSUER=

# --- App ---

ENVIRONMENT=development

# Origini ammesse per il CORS, separate da virgola.
CORS_ORIGINS=http://localhost:3000

# --- Cataloghi bibliografici ---

# URL o email di chi ospita QUESTA istanza, messo nel `User-Agent` di ogni
# richiesta verso una fonte esterna. Non è una cortesia: la policy Wikimedia
# (Wikidata, Wikipedia) esige un contatto e avverte che chi non lo dà "may be
# blocked without notice", e Open Library dà 3 richieste al secondo a chi si
# identifica contro 1 a chi resta anonimo. Vuoto ricade sull'indirizzo pubblico
# del progetto: valido per entrambe le policy, ma un eventuale blocco verrebbe
# notificato a chi ha scritto il codice, non a chi ospita l'istanza.
CONTATTO_OPERATORE=

# Fonte primaria della ricerca. Senza chiave l'API di Google Books non
# risponde affatto: restituisce 429 con `quota_limit_value: "0"`, non un
# limite ridotto. Open Library, Wikidata e Wikipedia non richiedono chiavi.
GOOGLE_BOOKS_API_KEY=

# --- Fornitore di modelli (docs/adr/0017, docs/adr/0018) ---

# Chiave OpenAI, condivisa da tutte le funzioni assistite: le
# bibliografiche (classificazione, deduzione, riconduzione autori,
# deduplicazione, standardizzazione descrizioni) e le personali
# (preview "me lo consigli?", embedding della ricerca semantica).
# Senza chiave le funzioni assistite falliscono senza bloccare nulla:
# un libro si aggiunge lo stesso, la ricerca semantica lo dichiara.
OPENAI_API_KEY=

# --- Lavori in secondo piano (docs/adr/0016) ---

# Avvia il worker dentro il processo FastAPI. Metterlo a false solo se il
# worker gira come processo separato (`python -m app.lavori`); i test lo
# disabilitano da soli.
WORKER_ABILITATO=true

# Attesa tra due passaggi sulla coda quando non c'è nulla da fare.
WORKER_INTERVALLO_SECONDI=2.0

# Quanti lavori il worker prende in carico e svolge IN PARALLELO a ogni
# passaggio. Un lavoro è quasi tutto attesa di rete: in serie, l'aggiunta
# di un libro (sette-otto lavori accodati insieme) sommava quelle attese.
# Non alzarlo molto senza alzare la memoria della macchina: la conversione
# di una copertina tiene l'immagine decompressa in RAM.
WORKER_LOTTO=3
