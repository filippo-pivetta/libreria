# URL pubblico del progetto Supabase.
# In locale corrisponde all'API URL stampato da `supabase start` (di norma http://localhost:54321).
VITE_SUPABASE_URL=

# Chiave pubblicabile del progetto Supabase (sb_publishable_…).
# In locale: PUBLISHABLE_KEY di `supabase status`; in produzione:
# Dashboard → Project Settings → API Keys.
# Tutte le variabili VITE_* finiscono nel bundle del browser: mai un segreto qui.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL del backend FastAPI, senza slash finale.
VITE_API_BASE_URL=http://localhost:8000
