# --- Supabase / database ---

# URL del progetto Supabase (locale: quello stampato da `supabase start`,
# di norma http://localhost:54321).
SUPABASE_URL=

# Chiave anon: usata per i client che operano con l'identità dell'utente,
# cosi che le regole di riga restino sempre valutate (docs/adr/0001).
SUPABASE_ANON_KEY=

# Chiave di servizio: riservata ai lavori in background, mai a richieste
# di utenti (docs/adr/0001).
SUPABASE_SERVICE_ROLE_KEY=

# Stringa di connessione diretta a Postgres (locale: quella stampata da
# `supabase start`).
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Autenticazione ---

# Issuer atteso nei JWT di sessione, verificato dalla dipendenza di
# autenticazione (docs/adr/0012). Lasciata vuota nella quasi totalità dei
# casi: si deriva da SUPABASE_URL (`${SUPABASE_URL}/auth/v1`), che è il
# default sia in locale sia sul progetto hosted. Da impostare solo se il
# progetto usa un dominio personalizzato che non coincide con SUPABASE_URL.
SUPABASE_JWT_ISSUER=

# --- App ---

ENVIRONMENT=development

# Origini ammesse per il CORS, separate da virgola.
CORS_ORIGINS=http://localhost:3000

# --- Cataloghi bibliografici ---

# Fonte primaria della ricerca. Senza chiave l'API di Google Books non
# risponde affatto: restituisce 429 con `quota_limit_value: "0"`, non un
# limite ridotto. Open Library, Wikidata e Wikipedia non richiedono chiavi.
GOOGLE_BOOKS_API_KEY=

# --- Funzioni assistite (non ancora implementate, vedi docs/prd.md) ---

OPENAI_API_KEY=

# --- Lavori in secondo piano (docs/adr/0016) ---

# Avvia il worker dentro il processo FastAPI. Metterlo a false solo se il
# worker gira come processo separato (`python -m app.lavori`); i test lo
# disabilitano da soli.
WORKER_ABILITATO=true

# Attesa tra due passaggi sulla coda quando non c'è nulla da fare.
WORKER_INTERVALLO_SECONDI=2.0
